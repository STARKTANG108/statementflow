# ==============================================================================
# 复制本文件并改名为 .env.local 即可生效（已被 Git 忽略，绝不泄露密钥）
# 在 Vercel 后台 Settings -> Environment Variables 中按需填入以下变量即可
# ==============================================================================

# 1. 你的正式域名（购买域名后替换）
NEXT_PUBLIC_SITE_URL=https://getstatementflow.com

# 2. 多模态扫描件/复杂版式解析密钥（OpenRouter 调用 google/gemini-2.5-flash）
# 注：未填写时，系统依然可用内置本地 unpdf 引擎 0 成本解析标准电子版 PDF！
# 填写后自动支持复杂双栏账单、手机拍照账单与纸质扫描件 OCR（单页成本仅约 $0.001）
OPENROUTER_API_KEY=

# 3. 个人免公司海外收款配置（Creem.io 过审后填入 API Key、Webhook 密钥与 3 档商品 ID）
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_TAX_PASS=
CREEM_PRODUCT_SMB_MONTHLY=
CREEM_PRODUCT_CPA_PRO=

# 4. Google 搜索收录验证与流量统计（上线后按需填入，未填时自动跳过）
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_GA_ID=
